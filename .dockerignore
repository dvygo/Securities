# Build context for docker/Dockerfile. Only premarket/, conf/, constituents/, tests/, the
# dependency files, LICENSE and packaging/'s build files are used.

.git
.github
dist/
docs/
deploy/
packaging/
!packaging/requirements.lock
!packaging/launcher.sh
!packaging/notices.py
**/.venv
**/__pycache__
**/*.py[cod]
**/.pytest_cache

# Real keys and config must never reach an image.
**/conf/config.ini
**/conf/keys.ini
**/conf/sinks/*.ini
**/secrets/

# Output of local runs, and a 6.x tree left on an upgraded host.
premarket/data/
bin/
constituents/contracts/
v6-python/
