# Build output (./build.sh, packaging/release.sh)
/build/
/build-sanitize/
/.cache/
/dist/

# Secrets and real configuration: only the .example templates are tracked
secrets/
**/config.ini
**/keys.ini
**/conf/sinks/*.ini

# Data a local run can leave in the tree when its [paths] point here
/state/
**/raw/
**/normalized/
/constituents/contracts/
/data/

# Archives, local databases, logs
*.zip
*.db
*.sqlite
*.sqlite3
*.log
**/LOGS/

# OS / editor
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

# Core dumps
core.[0-9]*
