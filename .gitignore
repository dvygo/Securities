# Python
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/

# Secrets and local config (never commit real keys)
secrets/
**/secrets.ini
**/config.ini
!**/config.example.ini
**/keys.ini
!**/keys.ini.example

# Legacy v3 scratch paths
__________v3/20*/
__________v3/config.ini
__________v3_EquityAlgoV20260519-0/config.ini
__________v3_EquityAlgoV20260519-0/*.zip
__________v3_EquityAlgoV20260519-0/output_matrix/
__________v3_EquityAlgoV20260519-0/output_matrix_*/

# Generated symbology / download output
**/raw/
**/normalized/
v4/**/20[0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9]/
v4/constituents/contracts/
v*-python/constituents/contracts/
data/[0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9]/
# v6 owns its data tree under the package (config.ini [paths].data_dir).
# Whole tree, not just raw/ and normalized/ -- plugin/ lands here too.
v*-python/premarket*/data/
v*-python/strategies*/*/data/
# Databento batch job downloads: one directory per job id, tens of GB of
# .dbn.zst. Not matched by the dated data/YYYYMMDD/ rule above.
data/_batch/

# Binaries, archives, local DBs
*.exe
*.zip
*.db
*.sqlite
*.sqlite3
/bin/
/vendor/
/dist/

# Logs and runtime dumps
*LOGS/
**/LOGS/
*.log

# Local scratch / experiments (not part of the pipeline)
v1-hist-downloader/

# OS / editor
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/
