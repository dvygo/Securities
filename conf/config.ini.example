# premarket 8 configuration. install.sh seeds DIR/conf/config.ini from this file once, with the
# directory it installs into in place of @DIR@. Pass it on every command:
#
#   @DIR@/bin/premarket --config=@DIR@/conf/config.ini --keys=@DIR@/conf/keys.ini <command>
#
# Every path is absolute. A key this file does not list is an error, so a typo cannot
# turn into a setting that is silently ignored. Comments start with # or ; at the start of
# a line or after whitespace; quote a value that has to contain " #".

[premarket]
config_version = 8

[paths]
data_dir      = @DIR@/state/data        # day trees YYYYMMDD/ and the numbering state _state/
contracts_dir = @DIR@/state/contracts   # basket contracts, one folder per day
logs_dir      = @DIR@/state/logs        # one log per run
reports_dir   = @DIR@/state/reports     # check-tokens / check-lineage / check-state reports
baskets_dir   = @DIR@/share/baskets     # basket definitions shipped with the release
sinks_dir     = @DIR@/conf/sinks        # one <name>.ini per load destination

[run]
# What "today" means when --date-dir is not given. The download of a Databento definition
# file additionally requires the date to be today in UTC (it is a replay of the live session).
timezone = Asia/Kolkata

[baskets]
enabled = 1        # 0 or 1: whether normalize builds the baskets at all

[fyers]
base_url        = https://public.fyers.in/sym_details
user_agent      = "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36"
timeout_sec     = 120
retries         = 3
retry_delay_sec = 2

# ---------------------------------------------------------------------------------------
# Venues. A venue with no section is unknown to every command.
#
#   feed      databento | fyers | nse | mcx
#   enabled   0 or 1; a disabled venue is skipped by download, normalize and load, but its
#             venue_id stays reserved
#   venue_id  recorded in every manifest and in the numbering state; a venue whose id
#             changes is refused rather than renumbered. Keep the values below on hosts that
#             already number: they are the ids 7.x numbered under.
#   dataset   Databento dataset (databento only)
#   stype_in  symbology of the symbols file (databento only); `parent` adds .OPT to bare roots
#   symbols   absolute path of the venue's symbol list (databento only); empty or absent =
#             every instrument in the dataset
#
# Definitions are a LIVE replay of the current session. When to fetch each, in UTC:
#   XNAS (EQUS.MINI) after ~05:00Z   XCME (GLBX.MDP3) any time after Sunday ~14:30Z
#   XCBO (OPRA.PILLAR) after ~12:00Z, when the day's new listings are in; all before 13:30Z.
# ---------------------------------------------------------------------------------------

[venue.XNAS]
feed     = databento
enabled  = 1
venue_id = 14
dataset  = EQUS.MINI
stype_in = raw_symbol
symbols  = @DIR@/conf/symbols/XNAS.txt

[venue.XCBO]
feed     = databento
enabled  = 1
venue_id = 10
dataset  = OPRA.PILLAR
stype_in = parent
symbols  = @DIR@/conf/symbols/XCBO.txt

[venue.XCME]
feed     = databento
enabled  = 1
venue_id = 12
dataset  = GLBX.MDP3
stype_in = parent
symbols  = @DIR@/conf/symbols/XCME.txt

[venue.XNSE]
# fyers = Fyers CDN (NSE_CM/FO/CD) -> XNSE-FYERS.parquet
# nse   = NSE's own contract masters in data/YYYYMMDD/XNSE/NEW FILE FORMAT/ -> XNSE-NSE.parquet
feed     = fyers
enabled  = 1
venue_id = 16

[venue.XBOM]
feed     = fyers
enabled  = 1
venue_id = 18

[venue.XIMC]
# fyers = Fyers CDN (MCX_COM) -> XIMC-FYERS.parquet
# mcx   = MCX's own contract file in data/YYYYMMDD/MCX/ -> XIMC-MCX.parquet
feed     = fyers
enabled  = 1
venue_id = 20
