# Copy to <sinks_dir>/postgres-plugin-xnas.ini and fill in. Projects the day's XNAS rows onto the
# legacy 17-column symbol master (docs/plugin/pg_data_types.txt) and upserts them on
# (token, trade_date). One market per sink; several sinks may point at the same table.
[sink]
type         = postgres-plugin
market       = XNAS
venue_id     = 14          # must equal [venue.XNAS] venue_id in config.ini, or the load is refused
database_url = postgres://plugin:plugin@127.0.0.1:6006/plugindb?sslmode=disable
schema       = public
table        = contracts
# 1 lets the push CREATE TABLE IF NOT EXISTS. Leave 0 on a managed database: "relation does
# not exist" is what catches a mistyped schema or table before anything is written.
create_table = 0
