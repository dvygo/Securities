# Copy to <sinks_dir>/mdf-tokenmap.ini and fill in. Writes MDF's tokenmap.<MIC>.bin
# (DBN instrument_id -> counterTokenV2) for the Databento venues.
[sink]
type    = mdf-tokenmap
markets = XCME,XNAS,XCBO # empty = every enabled Databento venue
# Absolute path of MDF's config/cpp-vendor/ to deliver in place (the write is atomic);
# empty = the day's own tree, data/YYYYMMDD/TRANSFORM/plugin/tokenmap/. Delivering a day
# older than the venue's newest live day is refused: MDF would load the old map as current.
dir     =
