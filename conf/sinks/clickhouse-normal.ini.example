# Copy to <sinks_dir>/clickhouse-normal.ini and fill in. `premarket load` pushes the day's
# canonical contracts (every venue, every column) and baskets: the dated tables
# contracts_YYYYMMDD / baskets_YYYYMMDD, and the always-current `contracts` / `baskets`
# mirrors -- which a day older than the newest live day never touches.
[sink]
type     = clickhouse-normal
host     = 127.0.0.1
port     = 8744          # the HTTP interface (docker/contract-clickhouse publishes 8123 on 8744)
database = xdb
username = xuser
password = changeme
secure   = 0             # 1 for HTTPS
