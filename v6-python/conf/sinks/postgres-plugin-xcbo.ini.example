# Copy to postgres-plugin-xcbo.ini (gitignored) and fill in.
# `premarketv6 load --sink postgres-plugin-xcbo` projects the day's XCBO rows onto
# the legacy 17-column symbol master (docs/plugin/pg_data_types.txt) and upserts
# them on (token, trade_date). One market per sink: `venue_id` must equal
# config.ini's [EXCHANGE:XCBO] venue_id, or the load is refused. Several sinks
# may point at the same table.
[sink]
type = postgres-plugin
market = XCBO
venue_id = 10
# Appender only -- table/schema must already exist (see docs/plugin/pg_data_types.txt).
database_url = postgres://plugin:plugin@127.0.0.1:6006/plugindb?sslmode=disable
schema = public
table = contracts
# May the appender CREATE TABLE IF NOT EXISTS its target? 0 or 1, a digit.
# Defaults to 0, and the default is the point: the plugin table is managed
# outside this repo, so "relation does not exist" is what catches a mistyped
# schema/table before anything is written. Set it to 1 only for a genuinely
# new database.
create_table = 0
