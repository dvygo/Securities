# Template — copy to config.ini and edit

[paths]
# All relative to repo root (v6-python/) unless absolute. v6 owns its own data
# tree; the day layout underneath is unchanged (YYYYMMDD/TRANSFORM/raw, .../normalized).
data_dir = premarketv6/data
baskets_dir = constituents/baskets
contracts_dir = constituents/contracts
bin_dir = bin
logs_dir = bin/LOGS

[databento]
# API keys now live in conf/keys.ini (per-exchange, per-environment: key_XNAS/key_XCBO/key_XCME).
live_seconds = 10
live_retries = 3
live_retry_delay_sec = 2
max_maps = 100000

[baskets]
# Whether the baskets step runs at all. 0 or 1, written as a digit --
# NOT true/false, matching [EXCHANGE:*] enabled. Absent section means 1.
# There is no command-line flag for this: whether a deployment builds
# baskets is a property of the deployment, not of whoever is running the
# command, so a scheduled run cannot change it by forgetting an argument.
# --basket <name> still selects WHICH basket to refresh when the step runs.
enabled = 1

[fyers]
base_url = https://public.fyers.in/sym_details
# Quote required: semicolons in UA are INI comments otherwise.
user_agent = "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36"
timeout_sec = 120
retries = 3
retry_delay_sec = 2

[postgres]
database_url = postgres://contract:contract@127.0.0.1:6006/contractdb?sslmode=disable

# Pushing moved to the load stage in 6.3.0: [clickhouse] and [postgres-plugin]
# are now sink files, conf/sinks/<name>.ini (templates: conf/sinks/*.ini.example),
# used as `premarketv6 load --sink <name>`. Sections left here are ignored.

# ---------------------------------------------------------------------------
# Per-exchange download policy. Authoritative: a venue with no section here is
# unknown to the pipeline. Replaces the venue table that used to live in
# sources/databento_src.VENUE_CONFIGS and the global [databento]
# hist_lookback_days -- both deleted, do not re-add.
#
#   feed                    databento | fyers
#   enabled                 0 or 1, written as a digit -- NOT true/false. One
#                           spelling so a grep for "enabled = 1" finds every
#                           live venue. Absent means 1. A disabled venue is
#                           skipped by every stage: download, normalize, plugin
#                           build and push. It is NOT the same as deleting the
#                           section -- the venue stays described and its
#                           venue_id is still held against every other venue's,
#                           so re-enabling it cannot collide with a prefix
#                           handed out while it was off.
#   venue_id                stable small integer identifying the venue. It is
#                           recorded in every manifest and in the numbering
#                           state, and a venue whose venue_id changes is refused
#                           rather than renumbered. It is NOT part of the token:
#                           one shared counter numbers every venue (see
#                           normalize/counter_token.py), so two venues cannot
#                           collide through it. Pre-flighted by
#                           counter_token.validate before any row is written:
#                           unset or duplicated is a CRITICAL error and that
#                           venue is skipped. A postgres-plugin sink
#                           (conf/sinks/) repeats its market's venue_id, and must
#                           match this value or the load is refused.
#
#   dataset                 Databento dataset id (databento feeds only)
#   schema                  schema of the definition download (a live replay)
#   stype_in                symbology type for basket downloads
#   stype_in_all_symbols    symbology type when --all-symbols is in play
#                           (blank = same as stype_in)
#   all_symbols_default     --all-symbols on unless --no-all-symbols is passed.
#                           true for every databento venue: the baskets were
#                           leaving most of each universe undownloaded.
#   hist_pin_latest_session resolve against the latest complete session only
#   hist_lookback_days      lookback window for the symbology.resolve path,
#                           i.e. basket downloads only -- definitions always
#                           come from the live replay now
#
# Definitions come from a LIVE replay of the current session (start=0), never
# the historical batch: Historical and Live assign instrument_id independently,
# and the MDF lanes run on live ids. What the live sessions sent, measured
# 2026-09-27..2026-10-02 (US daylight time; expect +1h UTC after 2026-11-01):
#
#   venue  dataset      session start      daily re-send   new contracts
#   XNAS   EQUS.MINI    Mon ~05:00Z        ~05:00Z         none
#   XCME   GLBX.MDP3    Sun ~14:30Z        none            spreads, all day
#   XCBO   OPRA.PILLAR  Mon 10:30Z         10:30Z          ~12:00Z daily
#
# So: XNAS after 05:00Z, XCME any time after Sunday's start, XCBO after 12:00Z
# (17:30 IST), all before the 13:30Z US open. Runbook: docs/PREMARKET-RUNBOOK.md.

[EXCHANGE:XNAS]
feed = databento
enabled = 1
venue_id = 14
dataset = EQUS.MINI
schema = definition
stype_in = raw_symbol
stype_in_all_symbols = raw_symbol
all_symbols_default = true
hist_pin_latest_session = false
hist_lookback_days = 7

[EXCHANGE:XCBO]
feed = databento
enabled = 1
venue_id = 10
dataset = OPRA.PILLAR
schema = definition
stype_in = parent
stype_in_all_symbols = parent
all_symbols_default = true
# OPRA reassigns instrument_id every trading day, so resolving against any date
# other than the latest complete session returns a token space that shares
# almost nothing with the live feed. See VenueConfig history in databento_src.
hist_pin_latest_session = true
hist_lookback_days = 7

[EXCHANGE:XCME]
feed = databento
enabled = 1
venue_id = 12
dataset = GLBX.MDP3
schema = definition
stype_in = parent
stype_in_all_symbols = raw_symbol
all_symbols_default = true
hist_pin_latest_session = false
hist_lookback_days = 7

[EXCHANGE:XNSE]
# Which feed serves XNSE. This is the real switch -- normalize steps run a
# venue only when they own it, and baskets resolve the normalized filename
# through it, so nothing is written twice and no file is renamed underneath.
#   fyers = Fyers CDN, NSE_CM/FO/CD  -> XNSE-FYERS.parquet
#   nse   = NSE's own contract masters, dropped by the broker into
#           data/YYYYMMDD/XNSE/NEW FILE FORMAT/ -> XNSE-NSE.parquet
feed = fyers
enabled = 1
venue_id = 16

[EXCHANGE:XBOM]
feed = fyers
enabled = 1
venue_id = 18

[EXCHANGE:XIMC]
feed = fyers
enabled = 1
venue_id = 20
